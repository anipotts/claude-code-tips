{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["bun-types"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*.astro", "src/**/*.ts", "astro.config.mjs"],
  "exclude": ["plugins", "hooks", "archive", "dist"]
}
