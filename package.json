{
  "name": "coding-agent-tips",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.4",
  "overrides": {
    "ajv": "8.20.0"
  },
  "scripts": {
    "dev": "node node_modules/astro/bin/astro.mjs dev",
    "edit": "node scripts/start-copy-review.mjs",
    "build": "node node_modules/astro/bin/astro.mjs build",
    "check": "node node_modules/astro/bin/astro.mjs check",
    "check:field-runs": "node scripts/check-field-runs.mjs",
    "check:handbook": "node scripts/check-handbook-structure.mjs",
    "check:completeness": "node scripts/check-handbook-completeness.mjs",
    "check:readme": "bun scripts/sync-readme.ts --check",
    "check:content": "node scripts/check-content.mjs",
    "check:links": "node scripts/check-editorial-links.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "test:site": "node scripts/check-typography.mjs && node scripts/test-site.mjs",
    "test:navigation": "node scripts/test-navigation.mjs",
    "test:a11y": "node scripts/test-a11y.mjs",
    "test:copy-review": "bun test src/copy-review",
    "audit:performance": "node scripts/audit-performance.mjs",
    "preview": "node node_modules/astro/bin/astro.mjs preview",
    "sync:readme": "bun scripts/sync-readme.ts",
    "verify": "bun run check:content && bun run test:copy-review && bun run build && bun run test:site && bun run check:performance && bun run test:navigation && bun run test:a11y"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.41.10",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@iconify-json/ph": "1.2.2",
    "astro": "7.2.10",
    "astro-icon": "1.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.2",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.4",
    "@types/mdast": "4.0.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsonc-parser": "3.3.1",
    "lighthouse": "13.4.1",
    "mdast-util-to-string": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  }
}
