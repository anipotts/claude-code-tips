---
import Adjustments from '@tabler/icons/outline/adjustments.svg';
import AppWindow from '@tabler/icons/outline/app-window.svg';
import ArrowRight from '@tabler/icons/outline/arrow-right.svg';
import Book from '@tabler/icons/outline/book.svg';
import BrandGithub from '@tabler/icons/outline/brand-github.svg';
import Compass from '@tabler/icons/outline/compass.svg';
import { getEntry, render } from 'astro:content';
import { getHomepagePages, routeForEntry } from '../content';
import AsciiBackground from '../components/AsciiBackground.astro';
import ProviderProductIcon from '../components/ProviderProductIcon.astro';
import { Card } from '../components/starwind/card';
import { Item, ItemContent, ItemDescription, ItemTitle } from '../components/starwind/item';
import { Separator } from '../components/starwind/separator';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatUpdatedAt } from '../date';
import { homepageHighlightsForScope, navigationScopes, site } from '../site';

const home = await getEntry('home', 'home');
if (!home) throw new Error('content/home.md is required');
const { Content } = await render(home);
const guides = await getHomepagePages();
const providerGroups = navigationScopes
  .filter((scope) => scope.id !== 'handbook')
  .map((scope) => {
    const pages = guides.filter((guide) => guide.data.navigation.scope === scope.id);
    return {
      ...scope,
      pages,
      overview: pages.find((page) => page.data.navigation.order === 10),
      highlights: homepageHighlightsForScope(scope.id),
      providerIconDark: 'providerIconDark' in scope ? scope.providerIconDark : undefined,
    };
  })
  .filter((scope) => scope.pages.length > 0);
const sharedGuides = guides.filter((guide) => guide.data.navigation.scope === 'handbook');
const highlightIcons = {
  'ph:app-window': AppWindow,
  'ph:sliders-horizontal': Adjustments,
  'ph:arrow-right': ArrowRight,
  'ph:book-open-text': Book,
  'ph:compass': Compass,
} as const;
---

<BaseLayout title={home.data.title} description={home.data.description}>
  <AsciiBackground />
  <main id="main" class="home-with-ascii">
    <article class="home-content"><Content /></article>

    <section class="home-guides" id="guides" aria-labelledby="guide-title">
      <header class="home-guides-heading">
        <p class="section-label">{site.interfaceCopy.guides}</p>
        <h2 id="guide-title">choose where to begin</h2>
      </header>
      <div class="provider-handbook-grid">
        {providerGroups.map((group) => (
          <section class="provider-handbook" aria-labelledby={`provider-${group.id}`}>
            <Card class="provider-handbook-card" size="sm">
            <header>
              <h3 id={`provider-${group.id}`}>
                <ProviderProductIcon light={group.providerIcon} dark={group.providerIconDark} />
                {group.label}
              </h3>
              {group.overview && <p>{group.overview.data.description}</p>}
            </header>
            <nav aria-label={`${group.label} distinct guide entry points`}>
              <ul>
                {group.highlights.map((highlight) => (
                  <li>
                    <Item as="a" href={highlight.href} size="sm">
                      <span class="provider-chapter-icon" aria-hidden="true">
                        {(() => { const HighlightIcon = highlightIcons[highlight.icon]; return <HighlightIcon />; })()}
                      </span>
                      <ItemContent><ItemTitle>{highlight.label}</ItemTitle></ItemContent>
                      <ArrowRight class="provider-chapter-arrow" aria-hidden="true" />
                    </Item>
                  </li>
                ))}
              </ul>
            </nav>
            </Card>
          </section>
        ))}
      </div>
      <section class="shared-handbook" aria-labelledby="shared-guides">
        <h3 id="shared-guides">{site.interfaceCopy.sharedFoundations}</h3>
        <div class="home-guide-list">
          {sharedGuides.map((guide) => (
            <>
              <Item as="a" href={routeForEntry(guide)} size="md">
                <ItemContent>
                  <ItemTitle>{guide.data.title}</ItemTitle>
                  <ItemDescription class="home-guide-description">{guide.data.description}</ItemDescription>
                </ItemContent>
                <ArrowRight aria-hidden="true" />
              </Item>
              <Separator />
            </>
          ))}
        </div>
      </section>
    </section>

  </main>
  <footer class="site-footer" id="site-footer">
    <a class="site-name footer-site-name" href="/" aria-label={site.interfaceCopy.home}>
      <img src="/favicon.svg" alt="" width="24" height="24" />
      <span>{site.name}</span>
    </a>
    <p class="footer-meta">{site.interfaceCopy.lastUpdated} {formatUpdatedAt(home.data.updatedAt)}</p>
    <nav aria-label="footer">
      <a href="/archive/">{site.interfaceCopy.archive}</a>
      <a href={site.releaseHistory}>{site.interfaceCopy.releases}</a>
      <a class="footer-github" href={site.repository} aria-label={site.interfaceCopy.github}><BrandGithub aria-hidden="true" /></a>
    </nav>
  </footer>
</BaseLayout>
