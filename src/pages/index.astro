---
import { Icon } from 'astro-icon/components';
import { getEntry, render } from 'astro:content';
import { getHandbookPages, routeForEntry } from '../content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { evidenceLabels } from '../evidence';
import { site } from '../site';

const home = await getEntry('home', 'home');
if (!home) throw new Error('content/home.md is required');
const { Content } = await render(home);
const guides = await getHandbookPages({ includeLegacy: false });
const verifiedDate = home.data.lastVerified.toISOString().slice(0, 10);
---

<BaseLayout title={home.data.title} description={home.data.description}>
  <main id="main">
    <article class="home-content"><Content /></article>

    <section class="home-guides" id="guides" aria-labelledby="guide-title">
      <header>
        <h2 id="guide-title">choose where to begin</h2>
      </header>
      <div class="home-guide-list">
        {
          guides.map((guide) => (
            <a href={routeForEntry(guide)}>
              <h3>{guide.data.title}</h3>
              <p>{guide.data.description}</p>
              <span>{guide.data.evidence.map((kind) => evidenceLabels[kind].label).join(' / ')}</span>
              <Icon name="ph:arrow-right" aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </section>

    <div class="home-meta" aria-label="page metadata">
      <span>{site.interfaceCopy.verified} {verifiedDate}</span>
      <span>{home.data.evidence.map((kind) => evidenceLabels[kind].label).join(' / ')}</span>
    </div>
  </main>
  <footer class="site-footer">
    <p>{site.name}</p>
    <nav aria-label="footer">
      <a href="/legacy/">{site.interfaceCopy.legacyPolicy}</a>
      <a href={site.releaseHistory}>{site.interfaceCopy.releases}</a>
      <a class="footer-github" href={site.repository} aria-label={site.interfaceCopy.github}><Icon name="ph:github-logo" aria-hidden="true" /></a>
    </nav>
  </footer>
</BaseLayout>
