---
import registry from '../../docs/sources.json';

type EvidenceKind = 'hands-on' | 'source-verified' | 'inference' | 'unknown';
type EvidenceEntry = {
  kind: EvidenceKind;
  label: string;
  section: string;
  sourceId?: string;
};

interface Props {
  entries: EvidenceEntry[];
  mobile?: boolean;
}

const { entries, mobile = false } = Astro.props;
const sources = new Map(registry.sources.map((source) => [source.id, source]));
const labels: Record<EvidenceKind, string> = {
  'hands-on': 'hands-on',
  'source-verified': 'source-verified',
  inference: 'inference',
  unknown: 'unknown',
};
const items = entries.map((entry) => ({ ...entry, source: entry.sourceId ? sources.get(entry.sourceId) : undefined }));
---

{
  mobile ? (
    <details class="evidence-rail mobile">
      <summary><span>evidence for this page</span><span>{items.length}</span></summary>
      <ol>
        {items.map((entry) => (
          <li>
            <a href={entry.source?.url ?? `#${entry.section}`} aria-label={`${entry.label}, ${labels[entry.kind]}${entry.source ? ', source' : ''}`}>
              <span class="evidence-label">{entry.label}</span>
              <span class:list={['evidence-kind', entry.kind]}>{labels[entry.kind]}</span>
            </a>
          </li>
        ))}
      </ol>
    </details>
  ) : (
    <aside class="evidence-rail" aria-labelledby="evidence-title">
      <p class="rail-title" id="evidence-title">evidence</p>
      <ol>
        {items.map((entry) => (
          <li>
            <a href={entry.source?.url ?? `#${entry.section}`} aria-label={`${entry.label}, ${labels[entry.kind]}${entry.source ? ', source' : ''}`}>
              <span class="evidence-label">{entry.label}</span>
              <span class:list={['evidence-kind', entry.kind]}>{labels[entry.kind]}</span>
            </a>
          </li>
        ))}
      </ol>
    </aside>
  )
}
