---
import registry from '../../docs/sources.json';

type EvidenceKind = 'hands-on' | 'source-verified' | 'inference' | 'unknown';
type EvidenceEntry = {
  kind: EvidenceKind;
  label: string;
  section: string;
  sourceId?: string;
};

interface Props {
  entries: EvidenceEntry[];
  mobile?: boolean;
}

const { entries, mobile = false } = Astro.props;
const sources = new Map(registry.sources.map((source) => [source.id, source]));
const labels: Record<EvidenceKind, string> = {
  'hands-on': 'hands-on',
  'source-verified': 'source-verified',
  inference: 'inference',
  unknown: 'unknown',
};
---

<aside class:list={['evidence-rail', { mobile }]} aria-labelledby={mobile ? 'mobile-evidence-title' : 'evidence-title'}>
  <p class="rail-title" id={mobile ? 'mobile-evidence-title' : 'evidence-title'}>evidence</p>
  <ol>
    {
      entries.map((entry) => {
        const source = entry.sourceId ? sources.get(entry.sourceId) : undefined;
        const label = (
          <>
            <span class:list={['evidence-kind', entry.kind]}>{labels[entry.kind]}</span>
            <span class="evidence-label">{entry.label}</span>
          </>
        );

        return (
          <li>
            {source ? (
              <a href={source.url} aria-label={`${entry.label}, ${labels[entry.kind]}, source`}>
                {label}
              </a>
            ) : (
              <a href={`#${entry.section}`}>{label}</a>
            )}
          </li>
        );
      })
    }
  </ol>
</aside>
