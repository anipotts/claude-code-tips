---
import Search from '@astrojs/starlight/components/Search.astro';
---

<div class="search-access"><Search /></div>

<script>
  declare global {
    interface Window {
      __codingAgentTipsSearchAccess?: boolean;
    }
  }

  if (!window.__codingAgentTipsSearchAccess) {
    document.addEventListener('click', (event) => {
      if (!(event.target as Element | null)?.closest('[data-search-trigger]')) return;

      const openWhenReady = (attempt = 0) => {
        const searchButton = document.querySelector<HTMLButtonElement>('.search-access [data-open-modal]');
        if (searchButton && !searchButton.disabled) {
          // Let the visible trigger's click finish before Starlight opens the
          // dialog. Its outside-click handler would otherwise close it again.
          setTimeout(() => searchButton.click(), 0);
          return;
        }
        if (attempt < 60) requestAnimationFrame(() => openWhenReady(attempt + 1));
      };

      openWhenReady();
    }, { capture: true });
    window.__codingAgentTipsSearchAccess = true;
  }
</script>

<style>
  .search-access {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    contain: inline-size;
  }

  .search-access:focus-within {
    inset-inline-end: 1rem;
    inset-block-start: 0.6rem;
    inline-size: min(24rem, calc(100vw - 2rem));
    block-size: auto;
    clip-path: none;
    overflow: visible;
    contain: none;
    z-index: var(--z-menu);
  }
</style>
