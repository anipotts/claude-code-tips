---
import { formatUpdatedAt } from '../date';
import { site } from '../site';

const { title, updatedAt } = Astro.locals.starlightRoute.entry.data;
---

<h1 id="_top">{title}</h1>
{updatedAt && <p class="page-meta" aria-label="page metadata">
  {site.interfaceCopy.lastUpdated} <time datetime={updatedAt}>{formatUpdatedAt(updatedAt)}</time>
</p>}
