---
import { Icon } from 'astro-icon/components';
---

<button class="theme-control" type="button" data-theme-control aria-label="toggle color theme" title="toggle color theme">
  <Icon class="theme-light-icon" name="ph:sun" aria-hidden="true" />
  <Icon class="theme-dark-icon" name="ph:moon" aria-hidden="true" />
</button>

<script>
  const themeStorageKey = 'coding-agent-tips:theme';
  let cleanupThemeControl = () => {};

  const setupThemeControl = () => {
    cleanupThemeControl();
    const controller = new AbortController();
    const systemTheme = matchMedia('(prefers-color-scheme: dark)');

    const readPreference = () => {
      try {
        const stored = localStorage.getItem(themeStorageKey);
        if (stored === 'light' || stored === 'dark' || stored === 'system') return stored;
      } catch {}
      return 'system';
    };

    const applyTheme = (preference: 'system' | 'light' | 'dark') => {
      const resolved = preference === 'system' ? (systemTheme.matches ? 'dark' : 'light') : preference;
      try { localStorage.setItem('starlight-theme', resolved); } catch {}
      document.documentElement.dataset.themePreference = preference;
      document.documentElement.dataset.theme = resolved;
      document.querySelectorAll<HTMLButtonElement>('[data-theme-control]').forEach((control) => {
        control.dataset.themeResolved = resolved;
        const nextTheme = resolved === 'dark' ? 'light' : 'dark';
        control.setAttribute('aria-label', `switch to ${nextTheme} mode`);
        control.title = `switch to ${nextTheme} mode`;
      });
    };

    document.querySelectorAll<HTMLButtonElement>('[data-theme-control]').forEach((button) => {
      button.addEventListener('click', () => {
        const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem(themeStorageKey, nextTheme); } catch {}
        applyTheme(nextTheme);
      }, { signal: controller.signal });
    });
    systemTheme.addEventListener('change', () => {
      if (readPreference() === 'system') applyTheme('system');
    }, { signal: controller.signal });
    applyTheme(readPreference());
    cleanupThemeControl = () => controller.abort();
  };

  document.addEventListener('astro:page-load', setupThemeControl);
  setupThemeControl();
</script>
