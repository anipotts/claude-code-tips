---
import { Icon } from 'astro-icon/components';
import { getHandbookPages, routeForEntry } from '../content';
import { navigationScopes, scopeForPath, site } from '../site';

const current = Astro.url.pathname;
const activeScope = scopeForPath(current);
const scopedPages = await getHandbookPages({ scope: activeScope });
const activeScopeLabel = navigationScopes.find((scope) => scope.id === activeScope)?.label ?? 'general';
---

<header class="site-header">
  <div class="header-main">
    <a class="site-name" href="/" aria-label={site.interfaceCopy.home}>
      <img src="/favicon.svg" alt="" width="24" height="24" />
      <span>{site.name}</span>
    </a>
    <div class="header-actions">
      <a
        class="github-link"
        href={site.repository}
        aria-label={`${site.interfaceCopy.github}, ${site.repositoryStars} stars`}
        title={`${site.repositoryStars} GitHub stars, checked ${site.repositoryStarsVerified}`}
      >
        <Icon name="ph:github-logo" aria-hidden="true" />
        <span class="github-stars" aria-hidden="true">{site.repositoryStars}</span>
      </a>
      <details class="mobile-site-menu">
        <summary role="button" aria-label={site.interfaceCopy.menu} aria-controls="mobile-scope-menu">
          <Icon class="menu-open-icon" name="ph:list" aria-hidden="true" />
          <Icon class="menu-close-icon" name="ph:x" aria-hidden="true" />
        </summary>
        <nav id="mobile-scope-menu" aria-label={`${activeScopeLabel} pages`}>
          {scopedPages.map((page) => {
            const href = routeForEntry(page);
            return <a href={href} aria-current={current === href ? 'page' : undefined}>{page.data.title}</a>;
          })}
        </nav>
      </details>
    </div>
  </div>
  <nav class="provider-tabs" aria-label={site.interfaceCopy.guides}>
    {navigationScopes.map((scope) => (
      <a href={scope.href} aria-current={activeScope === scope.id ? 'page' : undefined}>{scope.label}</a>
    ))}
  </nav>
</header>
