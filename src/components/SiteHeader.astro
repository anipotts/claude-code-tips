---
import { Icon } from 'astro-icon/components';
import { getHandbookPages, routeForEntry } from '../content';
import { site } from '../site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const current = Astro.url.pathname;
const links = (await getHandbookPages({ includeLegacy: false })).map((page) => ({
  href: routeForEntry(page),
  label: page.data.title,
}));
---

<header class:list={['site-header', { compact }]}>
  <a class="site-name" href="/" aria-label={site.interfaceCopy.home}>
    <span>{site.name}</span>
  </a>
  <nav aria-label="primary">
    {
      links.map(({ href, label }) => (
        <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>{label}</a>
      ))
    }
  </nav>
  <div class="header-actions">
    <a
      class="github-link"
      href={site.repository}
      aria-label={`${site.interfaceCopy.github}, ${site.repositoryStars} stars`}
      title={`${site.repositoryStars} GitHub stars, checked ${site.repositoryStarsVerified}`}
    >
      <Icon name="ph:github-logo" aria-hidden="true" />
      <span class="github-stars" aria-hidden="true">{site.repositoryStars}</span>
    </a>
    {
      !compact && (
        <details class="mobile-site-menu">
          <summary role="button" aria-label={site.interfaceCopy.menu} aria-controls="mobile-primary-menu"><Icon name="ph:list" aria-hidden="true" /></summary>
          <nav id="mobile-primary-menu" aria-label="mobile primary">
            {links.map((link) => (
              <a href={link.href} aria-current={current.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>
            ))}
          </nav>
        </details>
      )
    }
  </div>
</header>
