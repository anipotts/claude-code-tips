<script is:inline>
  (() => {
    const storageKey = 'coding-agent-tips:reading-rails';
    const desktop = matchMedia('(min-width: 48rem)').matches;
    let stored = null;
    try { stored = localStorage.getItem(storageKey); } catch {}

    const state = desktop && (stored === 'expanded' || stored === 'collapsed') ? stored : 'expanded';

    document.documentElement.dataset.leftRail = state;
    document.documentElement.dataset.rightRail = 'collapsed';
    document.documentElement.dataset.guideContextPanel = 'closed';
    document.documentElement.dataset.railStateReady = '';
  })();
</script>
