---
import { getHandbookPages, routeForEntry } from '../content';
import { navigationScopes, scopeForPath } from '../site';

const current = Astro.url.pathname;
const activeScope = scopeForPath(current);
const pages = await getHandbookPages({ scope: activeScope });
const label = navigationScopes.find((scope) => scope.id === activeScope)?.label ?? 'general';
---

<nav class="handbook-sidebar" aria-label={`${label} navigation`}>
  <p class="sidebar-label">{label}</p>
  <ul>
    {pages.map((page) => {
      const href = routeForEntry(page);
      return <li><a href={href} aria-current={current === href ? 'page' : undefined}>{page.data.title}</a></li>;
    })}
  </ul>
</nav>
