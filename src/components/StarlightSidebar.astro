---
import { Icon } from 'astro-icon/components';
import { getHandbookPages, routeForEntry } from '../content';
import { chapterForOrder, handbookScopes, scopeForPath } from '../site';
import ProviderProductIcon from './ProviderProductIcon.astro';

type TocNode = { depth: number; slug: string; text: string; children: TocNode[] };
type SidebarHeading = { depth: number; slug: string; text: string };

const current = Astro.url.pathname;
const activeScope = scopeForPath(current);
const pages = await getHandbookPages({ scope: activeScope });
const label = handbookScopes.find((scope) => scope.id === activeScope)?.label ?? 'general';
const activeScopeMetadata = handbookScopes.find((scope) => scope.id === activeScope);
const providerIcon = activeScopeMetadata?.providerIcon ?? '/favicon.svg';
const providerIconDark = activeScopeMetadata && 'providerIconDark' in activeScopeMetadata
  ? activeScopeMetadata.providerIconDark
  : undefined;

const navigationLabel = (page: (typeof pages)[number]) => activeScope === 'general'
  ? page.data.title
  : chapterForOrder(page.data.navigation.order)?.label ?? page.data.title;
const navigationIcon = (page: (typeof pages)[number]) => activeScope === 'general'
  ? 'ph:compass'
  : chapterForOrder(page.data.navigation.order)?.icon ?? 'ph:compass';

const { toc } = Astro.locals.starlightRoute;
const isOutline = Astro.locals.starlightRoute.entry.data.completion === 'outline';
const flattenHeadings = (items: TocNode[]): SidebarHeading[] => items.flatMap((item) => [
  { depth: item.depth, slug: item.slug, text: item.text },
  ...flattenHeadings(item.children),
]);
const headings = toc && !isOutline
  ? flattenHeadings(toc.items as TocNode[]).filter((item) => item.slug !== '_top' && item.depth <= 3)
  : [];
---

<div class="handbook-sidebar">
  <div class="handbook-rail-head">
    <div class="guide-rail-identity">
      <ProviderProductIcon class="sidebar-provider-icon" light={providerIcon} dark={providerIconDark} size={24} />
      <p class="sidebar-label"><span>{label}</span><span class="sidebar-kind">guide</span></p>
    </div>
    <button
      class="rail-toggle"
      type="button"
      data-rail-toggle="left"
      aria-expanded="true"
      aria-controls="handbook-navigation"
      aria-label="collapse guide navigation"
    >
      <Icon class="rail-toggle-collapse" name="ph:caret-double-left" aria-hidden="true" />
      <Icon class="rail-toggle-expand" name="ph:caret-double-right" aria-hidden="true" />
    </button>
  </div>
  <nav id="handbook-navigation" aria-label={activeScope === 'general' ? `${label} navigation` : `${label} handbook chapters`}>
    <ul>
      {pages.map((page, index) => {
        const href = routeForEntry(page);
        const itemLabel = navigationLabel(page);
        return (
          <li class:list={{ 'is-current-chapter': current === href }}>
            <a
              href={href}
              data-astro-prefetch="hover"
              data-label={itemLabel}
              data-chapter-index={index}
              style={`view-transition-name: handbook-chapter-row-${index}`}
              title={itemLabel}
              aria-label={itemLabel}
              aria-current={current === href ? 'page' : undefined}
            >
              <span class="sidebar-active-marker" aria-hidden="true"></span>
              <span class="sidebar-icon" aria-hidden="true"><Icon name={navigationIcon(page)} /></span>
              <span class="sidebar-link-copy">{itemLabel}</span>
            </a>
            {current === href && headings.length > 0 && (
              <div class="sidebar-page-outline" aria-label="on this page">
                <ul>
                  {headings.map((heading) => (
                    <li style={`--heading-depth: ${Math.max(0, heading.depth - 2)}`}>
                      <a href={`#${heading.slug}`} data-heading-id={heading.slug}>
                        <span class="sidebar-outline-marker" aria-hidden="true"></span>
                        <span>{heading.text}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  </nav>
</div>
<script>
  const railStorageKey = 'coding-agent-tips:reading-rails';
  const desktopRailQuery = matchMedia('(min-width: 48rem)');

  const applyRailState = (state: 'expanded' | 'collapsed') => {
    document.documentElement.dataset.leftRail = state;
    document.documentElement.dataset.rightRail = 'collapsed';
    const expanded = state === 'expanded';
    document.querySelectorAll<HTMLButtonElement>('[data-rail-toggle="left"]').forEach((button) => {
      button.setAttribute('aria-expanded', String(expanded));
      button.setAttribute('aria-label', `${expanded ? 'collapse' : 'expand'} guide navigation`);
    });
  };

  let cleanupRailControls: () => void = () => {};

  const setupRailControls = () => {
    cleanupRailControls();
    const controller = new AbortController();
    let storedRailState: string | null = null;
    try { storedRailState = localStorage.getItem(railStorageKey); } catch {}
    const initialRailState = desktopRailQuery.matches && (storedRailState === 'expanded' || storedRailState === 'collapsed')
      ? storedRailState
      : 'expanded';
    applyRailState(initialRailState);

    document.querySelectorAll<HTMLButtonElement>('[data-rail-toggle="left"]').forEach((button) => {
      button.addEventListener('click', () => {
        const currentState = document.documentElement.dataset.leftRail;
        const nextState = currentState === 'collapsed' ? 'expanded' : 'collapsed';
        try { localStorage.setItem(railStorageKey, nextState); } catch {}
        applyRailState(nextState);
      }, { signal: controller.signal });
    });

    const syncBreakpointState = () => {
      let stored: string | null = null;
      try { stored = localStorage.getItem(railStorageKey); } catch {}
      applyRailState(desktopRailQuery.matches && (stored === 'expanded' || stored === 'collapsed') ? stored : 'expanded');
    };
    desktopRailQuery.addEventListener('change', syncBreakpointState, { signal: controller.signal });

    cleanupRailControls = () => controller.abort();
  };

  document.addEventListener('astro:page-load', setupRailControls);
  setupRailControls();
</script>
