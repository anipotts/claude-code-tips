---
import Adjustments from '@tabler/icons/outline/adjustments.svg';
import AppWindow from '@tabler/icons/outline/app-window.svg';
import ArrowRight from '@tabler/icons/outline/arrow-right.svg';
import BrandGithub from '@tabler/icons/outline/brand-github.svg';
import Compass from '@tabler/icons/outline/compass.svg';
import GitBranch from '@tabler/icons/outline/git-branch.svg';
import ShieldCheck from '@tabler/icons/outline/shield-check.svg';
import { getHandbookPages, routeForEntry } from '../content';
import { chapterForOrder, handbookScopes, scopeForPath } from '../site';
import ProviderProductIcon from './ProviderProductIcon.astro';
import {
  Sidebar,
  SidebarContent,
  SidebarMenu,
  SidebarMenuButton,
  SidebarMenuItem,
  SidebarMenuSub,
  SidebarMenuSubButton,
  SidebarMenuSubItem,
  SidebarProvider,
  SidebarTrigger,
} from './starwind/sidebar';

type TocNode = { depth: number; slug: string; text: string; children: TocNode[] };
type SidebarHeading = { depth: number; slug: string; text: string };

const current = Astro.url.pathname;
const activeScope = scopeForPath(current);
const pages = await getHandbookPages({ scope: activeScope });
const label = handbookScopes.find((scope) => scope.id === activeScope)?.label ?? 'handbook';
const activeScopeMetadata = handbookScopes.find((scope) => scope.id === activeScope);
const providerIcon = activeScopeMetadata?.providerIcon ?? '/favicon.svg';
const providerIconDark = activeScopeMetadata && 'providerIconDark' in activeScopeMetadata
  ? activeScopeMetadata.providerIconDark
  : undefined;

const navigationLabel = (page: (typeof pages)[number]) => activeScope === 'handbook'
  ? page.data.title
  : chapterForOrder(page.data.navigation.order)?.label ?? page.data.title;
const chapterIcons = [Compass, ArrowRight, Adjustments, GitBranch, AppWindow, ShieldCheck, Compass];

const { toc } = Astro.locals.starlightRoute;
const isOutline = Astro.locals.starlightRoute.entry.data.completion === 'outline';
const flattenHeadings = (items: TocNode[]): SidebarHeading[] => items.flatMap((item) => [
  { depth: item.depth, slug: item.slug, text: item.text },
  ...flattenHeadings(item.children),
]);
const headings = toc && !isOutline
  ? flattenHeadings(toc.items as TocNode[]).filter((item) => item.slug !== '_top' && item.depth <= 3)
  : [];
---

<SidebarProvider
  class="publication-sidebar-provider"
  style={{ '--sidebar-width': '17rem', '--sidebar-width-icon': '3.5rem' }}
  persistOpen
  persistenceKey="publication-sidebar"
  persistenceStorage="localStorage"
  mobileQuery="(max-width: 47.99rem)"
>
  <Sidebar
    class="publication-sidebar"
    collapsible="icon"
    side="left"
    variant="sidebar"
    aria-label={activeScope === 'handbook' ? `${label} navigation` : `${label} handbook chapters`}
  >
    <div class="handbook-rail-head">
      <div class="guide-rail-identity">
        <ProviderProductIcon class="sidebar-provider-icon" light={providerIcon} dark={providerIconDark} size={28} />
        <p class="sidebar-label"><span>{label}</span><span class="sidebar-kind">guide</span></p>
      </div>
      <SidebarTrigger />
    </div>
    <SidebarContent class="publication-sidebar-content">
      <SidebarMenu>
        {pages.map((page, index) => {
          const href = routeForEntry(page);
          const itemLabel = navigationLabel(page);
          const NavigationIcon = chapterIcons[index] ?? BrandGithub;
          const active = current === href;
          return (
            <SidebarMenuItem class:list={{ 'is-current-chapter': active }}>
              <SidebarMenuButton
                href={href}
                data-astro-prefetch="hover"
                isActive={active}
                tooltip={itemLabel}
                size="sm"
                aria-current={active ? 'page' : undefined}
              >
                <NavigationIcon aria-hidden="true" />
                <span>{itemLabel}</span>
              </SidebarMenuButton>
              {active && headings.length > 0 && (
                <SidebarMenuSub class="sidebar-page-outline" aria-label="on this page">
                  {headings.map((heading) => (
                    <SidebarMenuSubItem style={`--heading-depth: ${Math.max(0, heading.depth - 2)}`}>
                      <SidebarMenuSubButton href={`#${heading.slug}`} data-heading-id={heading.slug} size="sm">
                        <span>{heading.text}</span>
                      </SidebarMenuSubButton>
                    </SidebarMenuSubItem>
                  ))}
                </SidebarMenuSub>
              )}
            </SidebarMenuItem>
          );
        })}
      </SidebarMenu>
    </SidebarContent>
  </Sidebar>
</SidebarProvider>
