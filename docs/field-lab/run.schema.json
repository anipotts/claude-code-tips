{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents.anipotts.com/schemas/field-run.schema.json",
  "title": "coding agent tips field run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "title",
    "status",
    "product",
    "productVersion",
    "model",
    "surface",
    "baseCommit",
    "taskSpecification",
    "machineProfile",
    "startedAt",
    "completedAt",
    "scenarios",
    "operatorInterventions",
    "reviewMinutes",
    "artifacts",
    "redactions",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["complete", "partial", "pending"] },
    "product": { "type": "string", "minLength": 1 },
    "productVersion": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "surface": { "type": "string", "minLength": 1 },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "taskSpecification": { "type": "string", "format": "uri-reference" },
    "machineProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "memoryGb", "notes"],
      "properties": {
        "platform": { "type": "string" },
        "architecture": { "type": "string" },
        "memoryGb": { "type": ["number", "null"], "minimum": 0 },
        "notes": { "type": ["string", "null"] }
      }
    },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "result", "elapsedSeconds", "evidence", "notes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "partial", "not-run"] },
          "elapsedSeconds": { "type": ["number", "null"], "minimum": 0 },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "format": "uri-reference" }
          },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "operatorInterventions": { "type": ["integer", "null"], "minimum": 0 },
    "reviewMinutes": { "type": ["number", "null"], "minimum": 0 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url", "description"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri-reference" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "redactions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
